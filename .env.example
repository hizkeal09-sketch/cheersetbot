# ---------------------------------------------------------------------------
# Cheers Dating - example environment file
# Copy to .env and fill in your own values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Database
# Zero-setup local default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./cheers.db
# Production / Docker (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://cheers:cheers@localhost:5432/cheers

# Comma-separated Telegram numeric IDs of administrators
# Tip: send /id to @userinfobot to find your numeric ID.
ADMIN_IDS=

# Public support contact shown to users
SUPPORT_CONTACT=@cheers_support

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/cheers.log
APP_TIMEZONE=Africa/Addis_Ababa
DROP_PENDING_UPDATES=false
AUTO_CREATE_TABLES=false

# Vercel / serverless deployment
# Set VERCEL=true and WEBHOOK_URL=https://your-project.vercel.app when deploying on Vercel.
VERCEL=false
WEBHOOK_PATH=/api/telegram
WEBHOOK_URL=
WEBHOOK_SECRET=replace-with-random-secret
SETUP_TOKEN=
CRON_SECRET=
BROADCAST_INLINE_SECONDS=20

# Premium / monetization
# false = launch mode: premium features are free for everyone
# true  = paywall mode: free daily limits and premium gating are enforced
PREMIUM_ENABLED=false
FREE_DAILY_DISCOVERIES=30
PREMIUM_DAILY_DISCOVERIES=300

# Safety
ALLOW_CONTACT_SHARING=false

# Anti-spam (per user, sliding window)
RATE_LIMIT_EVENTS=12
RATE_LIMIT_WINDOW_SECONDS=10

# Docker Compose PostgreSQL password (used only by docker-compose.yml)
# Use a long random value; never reuse a password from another service.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
